+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Mimir2 recurrent serving with request-owned attention caches.
+
+Small, cache-independent feature modules are shared with Transformers. Attention,
+linear layers and embedding/head projections use vLLM implementations.
+"""
+
+from collections.abc import Iterable
+
+import torch
+from torch import nn
+from transformers.models.mimir2.modeling_mimir2 import (
+    Mimir2InvocationGate,
+    Mimir2NGramMemory,
+    Mimir2RecurrentMemory,
+    Mimir2ResidualConnection,
+    Mimir2Router,
+)
+
+from vllm.compilation.decorators import support_torch_compile
+from vllm.config import VllmConfig
+from vllm.model_executor.layers.attention import Attention, PrefillPrefixLMAttention
+from vllm.model_executor.layers.layernorm import RMSNorm
+from vllm.model_executor.layers.logits_processor import LogitsProcessor
+from vllm.model_executor.layers.vocab_parallel_embedding import (
+    ParallelLMHead,
+    VocabParallelEmbedding,
+)
+from vllm.sequence import IntermediateTensors
+
+from .hrm_text import HrmTextAttention, HrmTextForCausalLM, HrmTextMLP
+from .utils import AutoWeightsLoader, maybe_prefix
+
+
+def recurrence_steps(config, level: str, expert: int = 0) -> list[int]:
+    stride = config.L_cycles * config.mos_num_experts + 1
+    if level == "H":
+        return [h * stride + stride - 1 for h in range(config.H_cycles)]
+    return [
+        h * stride + low_cycle * config.mos_num_experts + expert
+        for h in range(config.H_cycles)
+        for low_cycle in range(config.L_cycles)
+    ]
+
+
+def validate_config(vllm_config):
+    config = vllm_config.model_config.hf_config
+    if config.ngram_orders:
+        if vllm_config.scheduler_config.async_scheduling:
+            raise ValueError("Mimir2 n-grams require async_scheduling=False")
+        if getattr(vllm_config.parallel_config, "enable_dbo", False):
+            raise ValueError("Mimir2 n-grams do not support dual batch overlap")
+    if config.mos_sparse and not vllm_config.model_config.enforce_eager:
+        raise ValueError("Sparse MoS dynamic dispatch requires enforce_eager=True")
+    if vllm_config.parallel_config.pipeline_parallel_size != 1:
+        raise ValueError("Mimir2 pipeline parallelism is not supported")
+    if vllm_config.quant_config is not None:
+        raise ValueError("Mimir2 quantized loading has not been qualified")
+    if vllm_config.speculative_config is not None:
+        raise ValueError("Mimir2 speculative decoding is not supported")
+
+
+class Mimir2ServingNGram(Mimir2NGramMemory):
+    """One bounded causal window per scheduled token; no mutable graph state."""
+
+    def forward(self, hidden, windows):
+        output = torch.zeros_like(hidden)
+        hashes = [torch.zeros_like(windows[:, 0]) for _ in range(self.heads)]
+        valid = torch.ones_like(windows[:, 0], dtype=torch.bool)
+        for offset in range(max(self.orders)):
+            token = windows[:, offset]
+            valid = valid & (token >= 0)
+            hashes = [
+                (value * (65599 + 2 * head) + token + 1) % self.buckets
+                for head, value in enumerate(hashes)
+            ]
+            if offset + 1 in self.orders:
+                start = self.orders.index(offset + 1) * self.heads
+                retrieved = torch.cat(
+                    [
+                        torch.nn.functional.embedding(value, self.tables[start + head])
+                        for head, value in enumerate(hashes)
+                    ],
+                    dim=-1,
+                )
+                output = output + retrieved.to(hidden.dtype) * valid[:, None]
+        if self.contextual_gate:
+            context = torch.nn.functional.rms_norm(
+                hidden, (hidden.shape[-1],), eps=1e-6
+            )
+            memory = torch.nn.functional.rms_norm(output, (output.shape[-1],), eps=1e-6)
+            output = (
+                torch.sigmoid(self.query(context) + self.key(memory)).to(hidden.dtype)
+                * output
+            )
+        return hidden + self.alpha.to(hidden.dtype) * output
+
+
+def make_mlp(config, prefix):
+    return HrmTextMLP(
+        config.hidden_size,
+        config.intermediate_size,
+        config.hidden_act,
+        bias=config.mlp_bias,
+        prefix=prefix,
+    )
+
+
+class Mimir2MLPMixture(nn.Module):
+    """Dense reference execution of top-k routing (including sparse checkpoints)."""
+
+    def __init__(self, config, prefix):
+        super().__init__()
+        self.experts = nn.ModuleList(
+            make_mlp(config, f"{prefix}.experts.{i}")
+            for i in range(config.moe_num_experts)
+        )
+        self.router = Mimir2Router(config, config.moe_num_experts, config.moe_top_k, config.moe_aux_loss_free)
+
+    def forward(self, hidden):
+        weights = self.router(hidden)
+        output = torch.zeros_like(hidden)
+        for i, expert in enumerate(self.experts):
+            candidate = expert(hidden)
+            output = output + weights[..., i : i + 1].to(candidate.dtype) * candidate
+        return output
+
+
+class Mimir2SparseAttention(HrmTextAttention):
+    """Sparse projections with full scheduler metadata for paged attention.
+
+    Inactive request KV slots receive zeros and are never read by that request:
+    its expert selection is fixed from the original prompt throughout decoding.
+    """
+
+    def forward(
+        self, positions, hidden_states, current_step, selected=None, total=None
+    ):
+        if selected is None:
+            return super().forward(positions, hidden_states, current_step)
+        gqkv, _ = self.gqkv_proj(hidden_states)
+        gate, query, key, value = gqkv.split(
+            [self.q_size, self.q_size, self.kv_size, self.kv_size], dim=-1
+        )
+        query, key = self.rotary_emb(positions, query, key)
+        full_query = query.new_zeros((total, query.shape[-1])).index_copy(
+            0, selected, query
+        )
+        full_key = key.new_zeros((total, key.shape[-1])).index_copy(0, selected, key)
+        full_value = value.new_zeros((total, value.shape[-1])).index_copy(
+            0, selected, value
+        )
+        attended = self.attn_per_step[str(current_step)](
+            full_query, full_key, full_value
+        )
+        output, _ = self.o_proj(
+            torch.sigmoid(gate) * attended.index_select(0, selected)
+        )
+        return output
+
+
+class Mimir2Layer(nn.Module):
+    def __init__(self, config, level, expert, index, cache_config, prefix):
+        super().__init__()
+        self.self_attn = Mimir2SparseAttention(
+            config,
+            index,
+            level,
+            cache_config=cache_config,
+            prefix=f"{prefix}.self_attn",
+            recurrence_steps=recurrence_steps(config, level, expert),
+            attention_cls=PrefillPrefixLMAttention if config.prefix_lm else Attention,
+            cache_prefix=prefix.split(f".{level}_module", 1)[0] + ".recurrence.layers",
+        )
+        self.mlp = (
+            Mimir2MLPMixture(config, f"{prefix}.mlp")
+            if config.moe_num_experts > 1 and config.moe_levels in (level, "both")
+            else make_mlp(config, f"{prefix}.mlp")
+        )
+        self.input_layernorm = RMSNorm(
+            config.hidden_size, eps=config.rms_norm_eps, has_weight=False
+        )
+        self.post_attention_layernorm = RMSNorm(
+            config.hidden_size, eps=config.rms_norm_eps, has_weight=False
+        )
+        if config.residual_branches > 1 and config.residual_levels in (level, "both"):
+            for offset, name in enumerate(("attn_residual", "mlp_residual")):
+                setattr(
+                    self,
+                    name,
+                    Mimir2ResidualConnection(
+                        config.residual_branches,
+                        config.hidden_size,
+                        2 * index + offset,
+                        config.residual_write_init_scale,
+                        config.residual_input_dependent,
+                    ),
+                )
+
+    def forward(self, positions, hidden, step, alpha=None, selected=None, total=None):
+        if alpha is None:
+            hidden = hidden + self.self_attn(
+                positions, self.input_layernorm(hidden), step, selected, total
+            )
+            return hidden + self.mlp(self.post_attention_layernorm(hidden))
+        read = self.input_layernorm(self.attn_residual.read(hidden, alpha))
+        hidden = self.attn_residual.write(
+            hidden, self.self_attn(positions, read, step, selected, total), alpha
+        )
+        read = self.post_attention_layernorm(self.mlp_residual.read(hidden, alpha))
+        return self.mlp_residual.write(hidden, self.mlp(read), alpha)
+
+
+class Mimir2Stack(nn.Module):
+    def __init__(self, config, level, cache_config, prefix, expert=0):
+        super().__init__()
+        self.branches = (
+            config.residual_branches if config.residual_levels in (level, "both") else 1
+        )
+        self.layers = nn.ModuleList(
+            Mimir2Layer(config, level, expert, i, cache_config, f"{prefix}.layers.{i}")
+            for i in range(config.num_layers_per_stack)
+        )
+        self.final_norm = RMSNorm(
+            config.hidden_size, eps=config.rms_norm_eps, has_weight=False
+        )
+        if self.branches > 1:
+            self.residual_readout = nn.Parameter(
+                torch.zeros(self.branches, config.hidden_size)
+            )
+            self.register_buffer("residual_alpha", torch.tensor(config.residual_alpha))
+
+    def forward(self, positions, hidden, step, selected=None, total=None):
+        if self.branches == 1:
+            for layer in self.layers:
+                hidden = layer(positions, hidden, step, selected=selected, total=total)
+            return self.final_norm(hidden)
+        streams = hidden.unsqueeze(-2).expand(
+            *hidden.shape[:-1], self.branches, hidden.shape[-1]
+        )
+        for layer in self.layers:
+            streams = layer(
+                positions, streams, step, self.residual_alpha, selected, total
+            )
+        weights = (self.residual_alpha.float() * self.residual_readout.float()).softmax(
+            0
+        )
+        return self.final_norm((streams.float() * weights).sum(-2).to(hidden.dtype))
+
+
+@support_torch_compile
+class Mimir2Model(nn.Module):
+    def __init__(self, *, vllm_config: VllmConfig, prefix=""):
+        super().__init__()
+        config = self.config = vllm_config.model_config.hf_config
+        self.embed_tokens = VocabParallelEmbedding(
+            config.vocab_size, config.hidden_size, prefix=f"{prefix}.embed_tokens"
+        )
+        if config.ngram_orders:
+            self.ngram = Mimir2ServingNGram(config)
+        self.embedding_scale = config.embedding_scale
+        if self.embedding_scale is None:
+            self.embedding_scale = 1 / config.initializer_range
+        self.z_L_init = nn.Parameter(
+            torch.zeros(config.hidden_size), requires_grad=False
+        )
+        for level in ("L", "H"):
+            stack = Mimir2Stack(
+                config, level, vllm_config.cache_config, f"{prefix}.{level}_module"
+            )
+            setattr(self, f"{level}_module", stack)
+            if config.gates_enabled:
+                count = config.H_cycles * (config.L_cycles if level == "L" else 1)
+                stack.invocation_gates = nn.ModuleList(
+                    Mimir2InvocationGate(config.hidden_size) for _ in range(count)
+                )
+            count = (
+                config.l_memory_branches if level == "L" else config.h_memory_branches
+            )
+            if count > 1:
+                stack.memory = Mimir2RecurrentMemory(
+                    count, config.hidden_size, config.memory_alpha
+                )
+        if config.gates_enabled:
+            self.register_buffer("gate_alpha", torch.tensor(config.gate_alpha))
+        if config.mos_num_experts > 1:
+            self.L_module.stack_experts = nn.ModuleList(
+                Mimir2Stack(
+                    config,
+                    "L",
+                    vllm_config.cache_config,
+                    f"{prefix}.L_module.stack_experts.{i}",
+                    expert=i + 1,
+                )
+                for i in range(config.mos_num_experts - 1)
+            )
+            self.L_module.stack_router = Mimir2Router(
+                config, config.mos_num_experts, config.mos_top_k, config.mos_aux_loss_free
+            )
+
+    def embed_input_ids(self, input_ids):
+        return self.embed_tokens(input_ids) * self.embedding_scale
+
+    def _injection(self, stack, invocation, hidden, injection):
+        if not self.config.gates_enabled:
+            return injection
+        return stack.invocation_gates[invocation](hidden, injection, self.gate_alpha)
+
+    def forward(
+        self,
+        input_ids: torch.Tensor | None,
+        positions: torch.Tensor,
+        intermediate_tensors: IntermediateTensors | None = None,
+        inputs_embeds: torch.Tensor | None = None,
+        ngram_windows: torch.Tensor | None = None,
+        mos_prompt_ids: torch.Tensor | None = None,
+        mos_prompt_owners: torch.Tensor | None = None,
+        mos_prompt_counts: torch.Tensor | None = None,
+        mos_query_owners: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        high = (
+            self.embed_input_ids(input_ids) if inputs_embeds is None else inputs_embeds
+        )
+        if self.config.ngram_orders:
+            if inputs_embeds is not None or ngram_windows is None:
+                raise ValueError(
+                    "Mimir2 n-grams require scheduler token windows and token IDs"
+                )
+            high = self.ngram(high, ngram_windows)
+        low = self.z_L_init.to(high).expand_as(high)
+        memories = {}
+        for name, value in (("H", high), ("L", low)):
+            stack = getattr(self, f"{name}_module")
+            if hasattr(stack, "memory"):
+                memories[name] = stack.memory.initialize(value)
+        experts = [self.L_module, *getattr(self.L_module, "stack_experts", [])]
+        routes = None
+        if self.config.mos_sparse and len(experts) > 1:
+            if mos_prompt_ids is None:
+                from vllm.forward_context import get_forward_context
+
+                if get_forward_context().attn_metadata is not None:
+                    raise ValueError(
+                        "Sparse MoS requires runner-provided request prompt metadata"
+                    )
+                # Profile every expert on all dummy tokens to bound memory.
+                routes = high.new_full((high.shape[0], len(experts)), 1 / len(experts))
+            else:
+                embeddings = self.embed_input_ids(mos_prompt_ids)
+                pooled = embeddings.new_zeros(
+                    (mos_prompt_counts.shape[0], embeddings.shape[-1]),
+                    dtype=torch.float32,
+                )
+                pooled.index_add_(0, mos_prompt_owners, embeddings.float())
+                pooled = (pooled / mos_prompt_counts[:, None]).to(embeddings.dtype)
+                request_routes = self.L_module.stack_router(pooled)
+                routes = request_routes[mos_query_owners.clamp_min(0)]
+                routes = routes * (mos_query_owners >= 0)[:, None]
+        states = (
+            [low] * len(experts) if self.config.mos_state_mode == "separate" else None
+        )
+        step = 0
+        for h in range(self.config.H_cycles):
+            for low_cycle in range(self.config.L_cycles):
+                if "L" in memories:
+                    low = self.L_module.memory.read_state(memories["L"])
+                weights = (
+                    routes
+                    if routes is not None
+                    else (
+                        self.L_module.stack_router(low + high)
+                        if len(experts) > 1
+                        else None
+                    )
+                )
+                output, next_states = torch.zeros_like(high), []
+                for e, expert in enumerate(experts):
+                    previous = low if states is None else states[e]
+                    combined = previous + self._injection(
+                        self.L_module,
+                        h * self.config.L_cycles + low_cycle,
+                        previous,
+                        high,
+                    )
+                    if routes is None:
+                        candidate = expert(positions, combined, step)
+                    else:
+                        selected = (routes[:, e] != 0).nonzero().flatten()
+                        candidate = torch.zeros_like(combined)
+                        if selected.numel():
+                            values = expert(
+                                positions.index_select(0, selected),
+                                combined.index_select(0, selected),
+                                step,
+                                selected=selected,
+                                total=high.shape[0],
+                            )
+                            candidate.index_copy_(0, selected, values)
+                    step += 1
+                    weight = weights[..., e : e + 1] if weights is not None else None
+                    output = output + (
+                        weight.to(candidate.dtype) * candidate
+                        if weight is not None
+                        else candidate
+                    )
+                    if states is not None:
+                        next_states.append(
+                            torch.where(weight > 0, candidate, previous)
+                            if weight is not None
+                            else candidate
+                        )
+                low = output
+                states = next_states if states is not None else None
+                if "L" in memories:
+                    memories["L"] = self.L_module.memory.update(memories["L"], low)
+                    low = self.L_module.memory.read_state(memories["L"])
+            if "H" in memories:
+                high = self.H_module.memory.read_state(memories["H"])
+            high = self.H_module(
+                positions, high + self._injection(self.H_module, h, high, low), step
+            )
+            step += 1
+            if "H" in memories:
+                memories["H"] = self.H_module.memory.update(memories["H"], high)
+                high = self.H_module.memory.read_state(memories["H"])
+        return high
+
+
+def pack_weights(weights: Iterable[tuple[str, torch.Tensor]]):
+    """Pack split HF projections, refusing incomplete or mixed representations."""
+    groups = {}
+    seen = set()
+    for name, tensor in weights:
+        name = name.replace(".attn.", ".self_attn.")
+        if name in seen:
+            raise ValueError(f"Duplicate weight: {name}")
+        seen.add(name)
+        parts = name.split(".")
+        projection = parts[-2] if len(parts) > 1 else ""
+        attention = ".self_attn." in name or ".attn." in name
+        layout = (
+            ("gate_proj", "q_proj", "k_proj", "v_proj")
+            if attention
+            else ("gate_proj", "up_proj")
+        )
+        if projection in layout:
+            parts[-2] = "gqkv_proj" if attention else "gate_up_proj"
+            packed_name = ".".join(parts).replace(".attn.", ".self_attn.")
+            entry = groups.setdefault(packed_name, ({}, layout))
+            entry[0][projection] = tensor
+        else:
+            yield name, tensor
+    for name, (tensors, layout) in groups.items():
+        if name in seen or name.replace(".self_attn.", ".attn.") in seen:
+            raise ValueError(f"Mixed packed and split weights: {name}")
+        if set(tensors) != set(layout):
+            raise ValueError(f"Incomplete projection: {name}; got {sorted(tensors)}")
+        yield name, torch.cat([tensors[key] for key in layout], dim=0)
+
+
+class Mimir2ForCausalLM(HrmTextForCausalLM):
+    def prepare_sparse_mos_inputs(
+        self, input_batch, query_start_loc, num_tokens, device
+    ):
+        if not self.config.mos_sparse:
+            return {}
+        from .mimir2_routing import prepare_sparse_mos_inputs
+
+        return prepare_sparse_mos_inputs(
+            input_batch,
+            query_start_loc,
+            num_tokens,
+            device,
+            self.config.mos_sparse_routing,
+        )
+
+    def forward(
+        self,
+        input_ids,
+        positions,
+        intermediate_tensors=None,
+        inputs_embeds=None,
+        **kwargs,
+    ):
+        return self.model(
+            input_ids, positions, intermediate_tensors, inputs_embeds, **kwargs
+        )
+
+    def __init__(self, *, vllm_config: VllmConfig, prefix=""):
+        nn.Module.__init__(self)
+        validate_config(vllm_config)
+        self.config = vllm_config.model_config.hf_config
+        self.quant_config = None
+        self.model = Mimir2Model(
+            vllm_config=vllm_config, prefix=maybe_prefix(prefix, "model")
+        )
+        self.lm_head = (
+            self.model.embed_tokens
+            if self.config.tie_word_embeddings
+            else ParallelLMHead(
+                self.config.vocab_size,
+                self.config.hidden_size,
+                prefix=maybe_prefix(prefix, "lm_head"),
+            )
+        )
+        self.logits_processor = LogitsProcessor(self.config.vocab_size)
+
+    def load_weights(self, weights):
+        skip = ["lm_head."] if self.config.tie_word_embeddings else None
+        loaded = AutoWeightsLoader(self, skip_prefixes=skip).load_weights(
+            pack_weights(weights), mapper=self.hf_to_vllm_mapper
+        )
+        expected = set(dict(self.named_parameters()))
+        expected.update(
+            f"{name}.{key}" if name else key
+            for name, module in self.named_modules()
+            if not isinstance(module, Attention)
+            for key, value in module._buffers.items()
+            if value is not None and key not in module._non_persistent_buffers_set
+        )
+        missing = expected - loaded
+        if missing:
+            raise ValueError(f"Incomplete Mimir2 checkpoint: {sorted(missing)}")
+        return loaded
