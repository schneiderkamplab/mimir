+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Request-owned sparse MoS inputs, rebuilt from the scheduler's prompt records."""
+
+import torch
+
+
+def prepare_sparse_mos_inputs(input_batch, query_start_loc, num_tokens, device, policy):
+    tokens, owners, counts, queries = [], [], [], []
+    for row in range(input_batch.num_reqs):
+        length = int(input_batch.num_prompt_tokens[row])
+        if length < 1:
+            raise ValueError("Sparse MoS requires a nonempty tokenized prompt")
+        length = 1 if policy == "first_token" else length
+        if not input_batch.is_token_ids[row, :length].all():
+            raise ValueError("Sparse MoS routing requires prompt token IDs")
+        tokens.extend(input_batch.token_ids_cpu[row, :length].tolist())
+        owners.extend([row] * length)
+        counts.append(length)
+        queries.extend([row] * int(query_start_loc[row + 1] - query_start_loc[row]))
+    if len(queries) > num_tokens:
+        raise ValueError("Sparse MoS request boundaries exceed the scheduled batch")
+    queries.extend([-1] * (num_tokens - len(queries)))
+    return {
+        "mos_prompt_ids": torch.tensor(tokens, dtype=torch.long, device=device),
+        "mos_prompt_owners": torch.tensor(owners, dtype=torch.long, device=device),
+        "mos_prompt_counts": torch.tensor(counts, dtype=torch.long, device=device),
+        "mos_query_owners": torch.tensor(queries, dtype=torch.long, device=device),
+    }
+
+
+def prepare_ngram_windows(input_batch, query_start_loc, num_tokens, orders):
+    """Newest-first windows from synchronous scheduler records, bounded by batch.
+
+    Rebuild from request-owned records so reorder, chunking and preemption do
+    not transfer history between slots. -1 marks context before request start.
+    """
+    import numpy as np
+
+    width = max(orders)
+    result = np.full((num_tokens, width), -1, dtype=np.int64)
+    for row in range(input_batch.num_reqs):
+        start, end = map(int, query_start_loc[row : row + 2])
+        computed = int(input_batch.num_computed_tokens_cpu[row])
+        if end > num_tokens or start < 0 or end < start:
+            raise ValueError("N-gram request boundaries exceed scheduled batch")
+        for offset in range(width):
+            positions = np.arange(computed, computed + end - start) - offset
+            valid = positions >= 0
+            indices = positions[valid]
+            if not input_batch.is_token_ids[row, indices].all():
+                raise ValueError(
+                    "Mimir2 n-grams require token IDs, not prompt embeddings"
+                )
+            result[start:end, offset][valid] = input_batch.token_ids_cpu[row, indices]
+    return torch.from_numpy(result)
