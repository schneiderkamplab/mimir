+class Mimir2RotaryEmbedding(nn.Module):
+    def __init__(self, config: Mimir2Config):
+        super().__init__()
+        self.max_seq_len_cached = config.max_position_embeddings
+        self.original_max_seq_len = config.max_position_embeddings
+
+        self.config = config
+
+        self.rope_type = self.config.rope_parameters["rope_type"]
+        rope_init_fn: Callable = self.compute_default_rope_parameters
+        if self.rope_type != "default":
+            rope_init_fn = ROPE_INIT_FUNCTIONS[self.rope_type]
+        inv_freq, self.attention_scaling = rope_init_fn(self.config)
+
+        self.inv_freq = nn.Buffer(inv_freq, persistent=False)
+        self.original_inv_freq = nn.Buffer(inv_freq.clone(), persistent=False)
+
+    @staticmethod
+    def compute_default_rope_parameters(config: Mimir2Config, **kwargs) -> tuple[torch.Tensor, float]:
+        """
+        Computes the inverse frequencies according to the original RoPE implementation
+        Args:
+            config ([`~transformers.PreTrainedConfig`]):
+                The model configuration.
+        Returns:
+            Tuple of (`torch.Tensor`, `float`), containing the inverse frequencies for the RoPE embeddings and the
+            post-processing scaling factor applied to the computed cos/sin (unused in this type of RoPE).
+        """
+        base = config.rope_parameters["rope_theta"]
+        dim = getattr(config, "head_dim", None) or config.hidden_size // config.num_attention_heads
+
+        attention_factor = 1.0  # Unused in this type of RoPE
+        # Compute the inverse frequencies
+        inv_freq = 1.0 / (base ** (torch.arange(0, dim, 2, dtype=torch.float) / dim))
+        return inv_freq, attention_factor
+
+    @torch.no_grad()
+    @dynamic_rope_update  # power user: used with advanced RoPE types (e.g. dynamic rope)
+    def forward(self, x, position_ids):
+        freqs = position_ids[..., None].float() * self.inv_freq.to(device=x.device, dtype=torch.float)
+        emb = torch.cat((freqs, freqs), dim=-1)
+        cos = emb.cos() * self.attention_scaling
+        sin = emb.sin() * self.attention_scaling
+
+        return cos.to(dtype=x.dtype), sin.to(dtype=x.dtype)
+
+
+@auto_docstring
+class Mimir2Model(Mimir2PreTrainedModel):
+    def __init__(self, config):
+        super().__init__(config)
+        self.padding_idx = config.pad_token_id
+        self.vocab_size = config.vocab_size
+
+        self.embed_tokens = nn.Embedding(config.vocab_size, config.hidden_size, self.padding_idx)
+        self.rotary_emb = Mimir2RotaryEmbedding(config=config)
+        self.gradient_checkpointing = False
+
+        self.embedding_scale = config.embedding_scale
+
+        # Recursive module structures
+        self.L_module = Mimir2Stack(config)
+        # H and L may select different expert/branch layouts.
+        self.H_module = Mimir2Stack(config, level="H")
+        # Initial state for the low cycle module
+        self.z_L_init = nn.Parameter(torch.zeros(config.hidden_size), requires_grad=False)
+
+        raw_bp = list(config.L_bp_cycles)
+        self.L_bp_cycles_padded = [1] * max(0, config.H_cycles - len(raw_bp)) + raw_bp
+        if config.gates_enabled:
+            self.L_module.invocation_gates = nn.ModuleList(
+                [Mimir2InvocationGate(config.hidden_size) for _ in range(config.H_cycles * config.L_cycles)]
+            )
+            self.H_module.invocation_gates = nn.ModuleList(
+                [Mimir2InvocationGate(config.hidden_size) for _ in range(config.H_cycles)]
+            )
+            self.register_buffer("gate_alpha", torch.tensor(config.gate_alpha))
+        if config.mos_num_experts > 1:
+            self.L_module.stack_experts = nn.ModuleList(
+                [Mimir2Stack(config) for _ in range(config.mos_num_experts - 1)]
+            )
+            self.L_module.stack_router = Mimir2Router(config, config.mos_num_experts, config.mos_top_k)
+            if config.expert_freeze_base:
+                self.L_module.layers.requires_grad_(False)
+        for level, count in (("H", config.h_memory_branches), ("L", config.l_memory_branches)):
+            if count > 1:
+                getattr(self, f"{level}_module").memory = Mimir2RecurrentMemory(
+                    count, config.hidden_size, config.memory_alpha
+                )
+        if config.ngram_orders:
+            self.ngram = Mimir2NGramMemory(config)
+
+        # Initialize weights and apply final processing
+        self.post_init()
+
+    @merge_with_config_defaults
+    @capture_outputs
+    @auto_docstring
+    def forward(
+        self,
+        input_ids=None,
+        attention_mask=None,
+        position_ids=None,
+        past_key_values=None,
+        token_type_ids=None,
+        inputs_embeds=None,
+        use_cache=None,
+        bp_steps=None,
+        **kwargs,
+    ) -> BaseModelOutputWithPast:
+        r"""
+        bp_steps (`int`, *optional*):
+            Override the configured gradient-bearing invocation count for this forward pass.
+        token_type_ids (`torch.LongTensor` of shape `(batch_size, sequence_length)`, *optional*):
+            One for bidirectional instruction tokens, zero for causal response tokens.
+        """
+        if (input_ids is None) == (inputs_embeds is None):
+            raise ValueError("Specify exactly one of input_ids and inputs_embeds")
+        if inputs_embeds is None:
+            inputs_embeds = self.embed_tokens(input_ids)
+        hidden = inputs_embeds * self.embedding_scale
+        use_cache = self.config.use_cache if use_cache is None else use_cache
+        if use_cache and past_key_values is None:
+            past_key_values = Mimir2DynamicCache(config=self.config)
+        if self.config.mos_sparse and past_key_values is not None:
+            if not isinstance(past_key_values, Mimir2DynamicCache):
+                if past_key_values.get_seq_length() != 0:
+                    raise ValueError("Sparse MoS requires request routes in Mimir2DynamicCache")
+                past_key_values = Mimir2DynamicCache(config=self.config)
+            past_key_values.mos_reference_layer = self.config.num_hidden_layers - 1
+        if (
+            self.config.ngram_orders
+            and past_key_values is not None
+            and not isinstance(past_key_values, Mimir2DynamicCache)
+        ):
+            if past_key_values.get_seq_length() != 0:
+                raise ValueError("N-gram decoding requires Mimir2DynamicCache")
+            past_key_values = Mimir2DynamicCache(config=self.config)
+        if position_ids is None:
+            past_length = past_key_values.get_seq_length() if past_key_values is not None else 0
+            if attention_mask is not None and attention_mask.ndim == 2:
+                position_ids = (attention_mask.long().cumsum(-1) - 1).clamp_min(0)[:, -hidden.shape[1] :]
+            else:
+                position_ids = (torch.arange(hidden.shape[1], device=hidden.device) + past_length).unsqueeze(0)
+        if self.config.ngram_orders:
+            if input_ids is None:
+                raise ValueError("N-gram embeddings require input_ids")
+            hidden = self.ngram(
+                hidden, input_ids, position_ids, past_key_values.ngram_history if past_key_values is not None else None
+            )
+        mask_kwargs = {
+            "config": self.config,
+            "inputs_embeds": hidden,
+            "attention_mask": attention_mask,
+            "past_key_values": past_key_values,
+            "position_ids": position_ids,
+        }
+        if (
+            self.config.prefix_lm
+            and token_type_ids is not None
+            and (past_key_values is None or not past_key_values.is_initialized)
+        ):
+            mask_kwargs["block_sequence_ids"] = torch.where(token_type_ids == 1, 0, -1)
+        mask = create_causal_mask(**mask_kwargs)
+        rotary = self.rotary_emb(hidden, position_ids)
+        info = dict(
+            attention_mask=mask,
+            past_key_values=past_key_values,
+            position_embeddings=rotary,
+            position_ids=position_ids,
+            **kwargs,
+        )
+        high, low = hidden, self.z_L_init.to(hidden).expand_as(hidden)
+        memories = {}
+        for name, value in (("H", high), ("L", low)):
+            module = getattr(self, f"{name}_module")
+            if hasattr(module, "memory"):
+                memories[name] = module.memory.initialize(value)
+        experts = [self.L_module, *getattr(self.L_module, "stack_experts", [])]
+        states = [low] * len(experts) if self.config.mos_state_mode == "separate" else None
+        routes = None
+        if self.config.mos_sparse and past_key_values is not None:
+            routes = past_key_values.mos_routes
+        if self.config.mos_sparse and len(experts) > 1 and routes is None:
+            valid = (
+                attention_mask[:, -hidden.shape[1] :].bool()
+                if attention_mask is not None and attention_mask.ndim == 2
+                else torch.ones(hidden.shape[:2], dtype=torch.bool, device=hidden.device)
+            )
+            if self.config.mos_sparse_routing == "prefix_mean":
+                if token_type_ids is None:
+                    raise ValueError("Prefix routing requires token_type_ids")
+                valid = valid & (token_type_ids == 1)
+                if not valid.any(-1).all():
+                    raise ValueError("Prefix routing requires a nonempty instruction in every sequence")
+                route_input = (hidden * valid[..., None]).sum(1) / valid.sum(1, keepdim=True)
+            else:
+                if not valid.any(-1).all():
+                    raise ValueError("Sparse MoS requires a nonempty sequence")
+                route_input = hidden[torch.arange(hidden.shape[0], device=hidden.device), valid.int().argmax(-1)]
+            routes = self.L_module.stack_router(route_input)
+            if past_key_values is not None:
+                past_key_values.mos_routes = routes.detach().clone()
+        steps = self.config.bp_steps if bp_steps is None else bp_steps
+        if steps < 2:
+            raise ValueError("bp_steps must be at least two")
+        h_bp = min(self.config.H_cycles, steps - 1)
+        l_bp = min(self.config.H_cycles * self.config.L_cycles, steps - h_bp)
+        slot = 0
+        for h in range(self.config.H_cycles):
+            for l in range(self.config.L_cycles):
+                invocation = h * self.config.L_cycles + l
+                with torch.set_grad_enabled(
+                    torch.is_grad_enabled() and invocation >= self.config.H_cycles * self.config.L_cycles - l_bp
+                ):
+                    if "L" in memories:
+                        low = self.L_module.memory.read_state(memories["L"])
+                    weights = (
+                        (self.L_module.stack_router(low + high) if routes is None else routes[:, None])
+                        if len(experts) > 1
+                        else None
+                    )
+                    output, next_states = torch.zeros_like(high), []
+                    for e, expert in enumerate(experts):
+                        previous = low if states is None else states[e]
+                        combined = previous + self._injection(self.L_module, invocation, previous, high)
+                        if routes is None:
+                            candidate = expert(combined, cycle_offset=slot, **info)
+                        else:
+                            selected = (routes[:, e] != 0).nonzero().flatten()
+                            subinfo = dict(info)
+                            if past_key_values is not None:
+                                subinfo["past_key_values"] = Mimir2SparseCacheView(
+                                    past_key_values, selected, hidden.shape[0]
+                                )
+                            if mask is not None:
+                                if not isinstance(mask, torch.Tensor):
+                                    raise ValueError("Sparse MoS requires eager or SDPA attention")
+                                subinfo["attention_mask"] = mask.expand(hidden.shape[0], -1, -1, -1)[selected]
+                            subinfo["position_embeddings"] = tuple(
+                                x.expand(hidden.shape[0], -1, -1)[selected] for x in rotary
+                            )
+                            subinfo["position_ids"] = position_ids.expand(hidden.shape[0], -1)[selected]
+                            candidate = torch.zeros_like(combined)
+                            if selected.numel():
+                                candidate = candidate.index_copy(
+                                    0, selected, expert(combined[selected], cycle_offset=slot, **subinfo)
+                                )
+                        slot += self.config.num_layers_per_stack
+                        weight = weights[..., e : e + 1] if weights is not None else 1
+                        output = (
+                            output
+                            + (weight.to(candidate.dtype) if isinstance(weight, torch.Tensor) else weight) * candidate
+                        )
+                        if states is not None:
+                            next_states.append(
+                                torch.where(weight > 0, candidate, previous) if weights is not None else candidate
+                            )
+                    low = output
+                    states = next_states if states is not None else None
+                    if "L" in memories:
+                        memories["L"] = self.L_module.memory.update(memories["L"], low)
+                        low = self.L_module.memory.read_state(memories["L"])
+            with torch.set_grad_enabled(torch.is_grad_enabled() and h >= self.config.H_cycles - h_bp):
+                if "H" in memories:
+                    high = self.H_module.memory.read_state(memories["H"])
+                high = self.H_module(high + self._injection(self.H_module, h, high, low), cycle_offset=slot, **info)
+                slot += self.config.num_layers_per_stack
+                if "H" in memories:
+                    memories["H"] = self.H_module.memory.update(memories["H"], high)
+                    high = self.H_module.memory.read_state(memories["H"])
+        return BaseModelOutputWithPast(last_hidden_state=high, past_key_values=past_key_values)
+
+    def _injection(self, level, invocation, hidden, injection):
+        if not self.config.gates_enabled:
+            return injection
+        return level.invocation_gates[invocation](hidden, injection, self.gate_alpha)
+
+
+@auto_docstring
+class Mimir2ForCausalLM(Mimir2PreTrainedModel, GenerationMixin):
+    _tied_weights_keys = {"lm_head.weight": "model.embed_tokens.weight"}
+    _tp_plan = {"lm_head": "colwise_gather_output"}
+    _pp_plan = {"lm_head": (["hidden_states"], ["logits"])}
+    _fsdp_plan = {"lm_head": "keep_full_weight"}
+
+    def __init__(self, config):
+        super().__init__(config)
+        self.model = Mimir2Model(config)
+        self.vocab_size = config.vocab_size
+        self.lm_head = nn.Linear(config.hidden_size, config.vocab_size, bias=False)
+
+        # Initialize weights and apply final processing
+        self.post_init()
+
+    @can_return_tuple
+    @auto_docstring
+    def forward(
+        self,
+        input_ids: torch.LongTensor | None = None,
+        attention_mask: torch.Tensor | None = None,
+        position_ids: torch.LongTensor | None = None,
+        past_key_values: Cache | None = None,
+        token_type_ids: torch.LongTensor | None = None,
+        inputs_embeds: torch.FloatTensor | None = None,
+        labels: torch.LongTensor | None = None,
+        use_cache: bool | None = None,
+        logits_to_keep: int | torch.Tensor = 0,
+        **kwargs: Unpack[TransformersKwargs],
+    ) -> CausalLMOutputWithPast:
+        r"""
+        token_type_ids (`torch.LongTensor` of shape `(batch, seq_len)`, *optional*):
+            Per-position bidirectional/causal indicator. Tokens with `token_type_ids == 1`
+            form a single bidirectional block; all other positions are causal.
+        """
+        outputs: BaseModelOutputWithPast = self.model(
+            input_ids=input_ids,
+            attention_mask=attention_mask,
+            position_ids=position_ids,
+            past_key_values=past_key_values,
+            token_type_ids=token_type_ids,
+            inputs_embeds=inputs_embeds,
+            use_cache=use_cache,
+            **kwargs,
+        )
+
+        hidden_states = outputs.last_hidden_state
+        slice_indices = slice(-logits_to_keep, None) if isinstance(logits_to_keep, int) else logits_to_keep
+        logits = self.lm_head(hidden_states[:, slice_indices, :])
+
+        loss = None
+        if labels is not None:
+            loss = self.loss_function(logits=logits, labels=labels, vocab_size=self.config.vocab_size, **kwargs)
+
+        return CausalLMOutputWithPast(
+            loss=loss,
+            logits=logits,
+            past_key_values=outputs.past_key_values,
+            hidden_states=outputs.hidden_states,
+            attentions=outputs.attentions,
+        )
+
+    @staticmethod
+    def create_masks_for_generate(
+        config: PreTrainedConfig,
+        inputs_embeds: torch.Tensor,
+        attention_mask: torch.Tensor | None,
+        past_key_values: Cache | None,
+        position_ids: torch.Tensor | None,
+        token_type_ids: torch.Tensor | None = None,
+        is_first_iteration: bool | None = False,
+        **kwargs,
+    ) -> dict:
+        mask_kwargs = {
+            "config": config,
+            "inputs_embeds": inputs_embeds,
+            "attention_mask": attention_mask,
+            "past_key_values": past_key_values,
+            "position_ids": position_ids,
+        }
+        if token_type_ids is not None and is_first_iteration:
+            if config.prefix_lm:
+                mask_kwargs["block_sequence_ids"] = torch.where(token_type_ids == 1, 0, -1)
+            else:
+                logger.warning_once("`token_type_ids` was provided but `config.prefix_lm=False`; ignoring it.")
+
+        return create_masks_for_generate(**mask_kwargs)
+
+
+__all__ = ["Mimir2Model", "Mimir2ForCausalLM", "Mimir2PreTrainedModel"]
