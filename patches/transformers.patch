+# Copyright 2026 The Mimir authors and the HuggingFace Inc. team. All rights reserved.
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at http://www.apache.org/licenses/LICENSE-2.0
+
+"""Convert a consolidated native HRM-Text-v2 LMHead state, without importing its training repository.
+
+The input must already select raw or EMA weights, not optimizer state or FSDP shards.
+The JSON configuration is the flattened native architecture plus vocab_size/max_seq_len.
+"""
+
+import argparse
+import json
+import math
+import re
+from pathlib import Path
+
+import torch
+from safetensors.torch import load_file
+
+from transformers import AutoTokenizer, Mimir2Config, Mimir2ForCausalLM
+
+
+FEATURE_FIELDS = (
+    "gates_enabled",
+    "moe_num_experts",
+    "moe_top_k",
+    "moe_levels",
+    "moe_sparse",
+    "mos_num_experts",
+    "mos_top_k",
+    "mos_state_mode",
+    "mos_sparse",
+    "mos_sparse_routing",
+    "residual_branches",
+    "residual_levels",
+    "residual_input_dependent",
+    "residual_write_init_scale",
+    "h_memory_branches",
+    "l_memory_branches",
+    "ngram_orders",
+    "ngram_buckets",
+    "ngram_heads",
+    "ngram_contextual_gate",
+    "router_top1_straight_through",
+    "expert_freeze_base",
+)
+
+
+def convert_config(native):
+    if native.get("norm_type", "pre") != "pre" or native.get("pos_emb_type", "rope") != "rope":
+        raise ValueError("Mimir2 currently supports pre-norm RoPE checkpoints only")
+    if native.get("H_override"):
+        raise ValueError("Asymmetric H_override requires a dedicated conversion")
+    if native.get("attn_type", "prefixlm") not in ("prefixlm", "causal"):
+        raise ValueError("Unsupported attention type")
+    size = native["hidden_size"]
+    init_type = native.get("init_type", "lecun_normal")
+    if init_type == "lecun_normal":
+        std = 1 / math.sqrt(size)
+    elif init_type == "fixed_normal":
+        std = native.get("init_std") or 0.02
+    elif init_type == "megatron":
+        std = native.get("init_std") or 1 / math.sqrt(size)
+    else:
+        raise ValueError(f"Unsupported initialization: {init_type}")
+    layers = native["n_layers"]
+    if native.get("half_layers", False):
+        if layers % 2:
+            raise ValueError("half_layers requires an even n_layers")
+        layers //= 2
+    return Mimir2Config(
+        vocab_size=native["vocab_size"],
+        hidden_size=size,
+        intermediate_size=((round(native.get("expansion", 4.0) * size * 2 / 3) + 255) // 256) * 256,
+        num_hidden_layers=layers,
+        num_attention_heads=native["num_heads"],
+        head_dim=size // native["num_heads"],
+        max_position_embeddings=native["max_seq_len"],
+        H_cycles=native["H_cycles"],
+        L_cycles=native["L_cycles"],
+        bp_steps=native.get("bp_max_steps", 5),
+        rms_norm_eps=native.get("norm_eps", 1e-6),
+        rope_parameters={"rope_type": "default", "rope_theta": float(native.get("rope_theta", 10000))},
+        initializer_range=std,
+        embedding_scale=1 / std,
+        prefix_lm=native.get("attn_type", "prefixlm") == "prefixlm",
+        tie_word_embeddings=False,
+        **{key: native[key] for key in FEATURE_FIELDS if key in native},
+    )
+
+
+def convert_state_dict(state):
+    converted = {}
+    for key, value in state.items():
+        if ".rotary_emb." in key or key == "model.routing_bias_scale":
+            # Rotary tables are nonpersistent. Metadata routing bias is training-only.
+            continue
+        key = key.replace("embed_tokens.embedding_weight", "model.embed_tokens.weight")
+        key = key.replace("model.zL_init", "model.z_L_init")
+        for level in ("L", "H"):
+            key = key.replace(f"model.{level}_level.core.", f"model.{level}_module.")
+            key = key.replace(f"model.{level}_level.", f"model.{level}_module.")
+        if key.endswith(".attn.gqkv_proj.weight"):
+            if value.shape[0] % 4:
+                raise ValueError(f"Invalid packed MHA tensor: {key}")
+            prefix = key.removesuffix(".attn.gqkv_proj.weight")
+            for name, tensor in zip(("gate_proj", "q_proj", "k_proj", "v_proj"), value.chunk(4, dim=0), strict=True):
+                converted[f"{prefix}.self_attn.{name}.weight"] = tensor.contiguous()
+        elif re.search(r"\.mlp(?:\.experts\.\d+)?\.gate_up_proj\.weight$", key):
+            prefix = key.removesuffix(".gate_up_proj.weight")
+            for name, tensor in zip(("gate_proj", "up_proj"), value.chunk(2, dim=0), strict=True):
+                converted[f"{prefix}.{name}.weight"] = tensor.contiguous()
+        else:
+            key = key.replace(".attn.o_proj.", ".self_attn.o_proj.")
+            converted[key] = value.contiguous()
+    return converted
+
+
+def convert_checkpoint(state, native_config):
+    config = convert_config(native_config)
+    converted = convert_state_dict(state)
+    with torch.device("meta"):
+        model = Mimir2ForCausalLM(config)
+    # Strict loading validates all tensor names and shapes, including opt-in buffers.
+    model.load_state_dict(converted, strict=True, assign=True)
+    # Nonpersistent rotary buffers are absent from the state dict and remain meta.
+    model.model.rotary_emb = type(model.model.rotary_emb)(config)
+    return model.eval()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--state-dict", type=Path, required=True)
+    parser.add_argument("--config", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument(
+        "--tokenizer", help="Copy the existing tokenizer and its chat template, without rewriting them"
+    )
+    args = parser.parse_args()
+    if args.output_dir.exists() and any(args.output_dir.iterdir()):
+        parser.error("Output directory must be empty; never overwrite a production export")
+    state = (
+        load_file(str(args.state_dict))
+        if args.state_dict.suffix == ".safetensors"
+        else torch.load(args.state_dict, map_location="cpu", weights_only=True)
+    )
+    model = convert_checkpoint(state, json.loads(args.config.read_text()))
+    model.save_pretrained(args.output_dir)
+    if args.tokenizer:
+        tokenizer = AutoTokenizer.from_pretrained(args.tokenizer)
+        tokenizer.save_pretrained(args.output_dir)
+        model.config.bos_token_id = tokenizer.bos_token_id
+        model.config.eos_token_id = tokenizer.eos_token_id
+        model.config.pad_token_id = tokenizer.pad_token_id
+        model.config.save_pretrained(args.output_dir)
+        model.generation_config.bos_token_id = tokenizer.bos_token_id
+        model.generation_config.eos_token_id = tokenizer.eos_token_id
+        model.generation_config.pad_token_id = tokenizer.pad_token_id
+        model.generation_config.save_pretrained(args.output_dir)
+
+
+if __name__ == "__main__":
+    main()
