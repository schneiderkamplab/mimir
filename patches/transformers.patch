+@auto_docstring
+@strict
+class Mimir2Config(HrmTextConfig):
+    r"""
+    H_cycles (`int`, *optional*, defaults to 2):
+        Number of high-level recurrent calls.
+    L_cycles (`int`, *optional*, defaults to 3):
+        Number of low-level calls before each high-level call.
+    L_bp_cycles (`list[int]`, *optional*):
+        Legacy HRM-Text field, retained for serialization compatibility. Mimir2 uses `bp_steps`.
+    embedding_scale (`float`, *optional*):
+        Input embedding multiplier, defaulting to the inverse initializer range.
+    prefix_lm (`bool`, *optional*, defaults to `True`):
+        Enable bidirectional instruction-prefix attention through `token_type_ids`.
+    num_layers_per_stack (`int`, *optional*):
+        Physical layers per stack. Inferred from `num_hidden_layers` on first construction;
+        the latter then represents the number of independent recurrent cache slots.
+    gates_enabled (`bool`, *optional*, defaults to `False`):
+        Enable independent input-dependent channel gates for each H/L invocation.
+    bp_steps (`int`, *optional*, defaults to 5):
+        Number of trailing recurrent invocations receiving gradients. H calls have priority,
+        leaving at least one L call. This does not change inference recurrence.
+    gate_alpha (`float`, *optional*, defaults to 0.0):
+        Initial gate strength. Effective strengths are persistent checkpoint buffers.
+    moe_num_experts (`int`, *optional*, defaults to 1):
+        Number of MLP experts per selected transformer block.
+    moe_top_k (`int`, *optional*, defaults to 1):
+        Number of active MLP experts per token.
+    moe_levels (`str`, *optional*, defaults to `"L"`):
+        Stacks receiving MLP experts: `"L"`, `"H"`, or `"both"`.
+    moe_sparse (`bool`, *optional*, defaults to `False`):
+        Dispatch only selected tokens to each MLP expert.
+    mos_num_experts (`int`, *optional*, defaults to 1):
+        Number of L-stack experts.
+    mos_top_k (`int`, *optional*, defaults to 1):
+        Number of active L stacks.
+    mos_state_mode (`str`, *optional*, defaults to `"shared"`):
+        Use one shared L state or `"separate"` states per expert.
+    mos_sparse (`bool`, *optional*, defaults to `False`):
+        Route complete batch sequences rather than tokens, retaining routes during cached decoding.
+    mos_sparse_routing (`str`, *optional*, defaults to `"first_token"`):
+        Route from the first valid token or `"prefix_mean"` of instruction tokens.
+    residual_branches (`int`, *optional*, defaults to 1):
+        Number of within-stack residual streams. Attention/MLP execute once per layer.
+    residual_levels (`str`, *optional*, defaults to `"both"`):
+        Stacks receiving residual streams.
+    residual_input_dependent (`bool`, *optional*, defaults to `False`):
+        Modulate stream mixing by the token's current state.
+    residual_write_init_scale (`float`, *optional*, defaults to 0.1):
+        Initial asymmetric write-logit scale.
+    residual_alpha (`float`, *optional*, defaults to 0.0):
+        Initial residual-stream strength.
+    h_memory_branches (`int`, *optional*, defaults to 1):
+        Number of H depth-recurrent memory branches.
+    l_memory_branches (`int`, *optional*, defaults to 1):
+        Number of L depth-recurrent memory branches.
+    memory_alpha (`float`, *optional*, defaults to 0.0):
+        Initial recurrent-memory strength.
+    ngram_orders (`list[int]`, *optional*):
+        Causal hashed n-gram orders, each unique and at least two. Empty disables n-grams.
+    ngram_heads (`int`, *optional*, defaults to 1):
+        Independently hashed split-width heads per n-gram order.
+    ngram_contextual_gate (`bool`, *optional*, defaults to `False`):
+        Gate retrieved memory with projected RMS-normalized context and memory.
+    ngram_buckets (`int`, *optional*, defaults to 4096):
+        Number of embedding buckets per n-gram order.
+    ngram_alpha (`float`, *optional*, defaults to 0.0):
+        Initial n-gram contribution strength.
+    router_top1_straight_through (`bool`, *optional*, defaults to `True`):
+        Enable the native top-1 router surrogate gradient.
+    expert_freeze_base (`bool`, *optional*, defaults to `False`):
+        Freeze expert zero and its router row.
+    """
+
+    model_type = "mimir2"
+    # Expert layouts and recurrent state need a dedicated distributed inference plan.
+    base_model_tp_plan = {}
+    base_model_pp_plan = {}
+    gates_enabled: bool = False
+    bp_steps: int = 5
+    gate_alpha: float = 0.0
+    moe_num_experts: int = 1
+    moe_top_k: int = 1
+    moe_levels: str = "L"
+    moe_sparse: bool = False
+    mos_num_experts: int = 1
+    mos_top_k: int = 1
+    mos_state_mode: str = "shared"
+    mos_sparse: bool = False
+    mos_sparse_routing: str = "first_token"
+    residual_branches: int = 1
+    residual_levels: str = "both"
+    residual_input_dependent: bool = False
+    residual_write_init_scale: float = 0.1
+    residual_alpha: float = 0.0
+    h_memory_branches: int = 1
+    l_memory_branches: int = 1
+    memory_alpha: float = 0.0
+    ngram_orders: list[int] | None = None
+    ngram_heads: int = 1
+    ngram_contextual_gate: bool = False
+    ngram_buckets: int = 4096
+    ngram_alpha: float = 0.0
+    router_top1_straight_through: bool = True
+    expert_freeze_base: bool = False
+
+    def __post_init__(self, **kwargs):
+        super().__post_init__(**kwargs)
+        self.ngram_orders = [] if self.ngram_orders is None else list(self.ngram_orders)
+        if min(self.H_cycles, self.L_cycles, self.num_layers_per_stack) < 1 or self.bp_steps < 2:
+            raise ValueError("Cycles/layers must be positive and bp_steps must be at least two")
+        for count, active in ((self.moe_num_experts, self.moe_top_k), (self.mos_num_experts, self.mos_top_k)):
+            if not 1 <= active <= count:
+                raise ValueError("Expert routing requires 1 <= top_k <= num_experts")
+        if self.moe_levels not in ("L", "H", "both") or self.residual_levels not in ("L", "H", "both"):
+            raise ValueError("Stack selection must be L, H or both")
+        if self.mos_state_mode not in ("shared", "separate"):
+            raise ValueError("mos_state_mode must be shared or separate")
+        if self.mos_sparse_routing not in ("first_token", "prefix_mean"):
+            raise ValueError("Invalid sparse MoS routing policy")
+        if self.mos_sparse and self.mos_sparse_routing == "prefix_mean" and not self.prefix_lm:
+            raise ValueError("Prefix-mean routing requires PrefixLM")
+        if self.mos_state_mode == "separate" and self.l_memory_branches > 1:
+            raise ValueError("Expert-specific L states cannot be combined with general L memory branches")
+        if min(self.residual_branches, self.h_memory_branches, self.l_memory_branches) < 1:
+            raise ValueError("Branch counts must be positive")
+        if (
+            self.ngram_buckets < 2
+            or len(set(self.ngram_orders)) != len(self.ngram_orders)
+            or any(order < 2 for order in self.ngram_orders)
+        ):
+            raise ValueError("N-gram orders must be unique and >= 2, with at least two buckets")
+        if self.ngram_heads < 1 or self.hidden_size % self.ngram_heads:
+            raise ValueError("N-gram heads must be positive and divide hidden_size")
+        for alpha in (self.gate_alpha, self.residual_alpha, self.memory_alpha, self.ngram_alpha):
+            if not 0 <= alpha <= 1:
+                raise ValueError("Feature strengths must lie in [0, 1]")
+        self.num_hidden_layers = self.num_layers_per_stack * self.H_cycles * (self.L_cycles * self.mos_num_experts + 1)
+
