+class Mimir2RMSNorm(torch.nn.Module):
+    def __init__(self, eps: float = 1e-6):
+        super().__init__()
+        self.eps = eps
+
+    def _norm(self, x):
+        return x * torch.rsqrt(x.pow(2).mean(-1, keepdim=True) + self.eps)
+
+    def forward(self, x):
+        return self._norm(x.float()).type_as(x)
+
+    def extra_repr(self):
+        return f"eps={self.eps}"
+
+
+def rotate_half(x):
+    """Rotates half the hidden dims of the input."""
+    x1 = x[..., : x.shape[-1] // 2]
+    x2 = x[..., x.shape[-1] // 2 :]
+    return torch.cat((-x2, x1), dim=-1)
+
+
+@use_kernel_forward_from_hub("rotary_pos_emb")
+def apply_rotary_pos_emb(q, k, cos, sin, unsqueeze_dim=1):
+    """Applies Rotary Position Embedding to the query and key tensors.
+
+    Args:
+        q (`torch.Tensor`): The query tensor.
+        k (`torch.Tensor`): The key tensor.
+        cos (`torch.Tensor`): The cosine part of the rotary embedding.
+        sin (`torch.Tensor`): The sine part of the rotary embedding.
+        unsqueeze_dim (`int`, *optional*, defaults to 1):
+            The 'unsqueeze_dim' argument specifies the dimension along which to unsqueeze cos[position_ids] and
+            sin[position_ids] so that they can be properly broadcasted to the dimensions of q and k. For example, note
+            that cos[position_ids] and sin[position_ids] have the shape [batch_size, seq_len, head_dim]. Then, if q and
+            k have the shape [batch_size, heads, seq_len, head_dim], then setting unsqueeze_dim=1 makes
+            cos[position_ids] and sin[position_ids] broadcastable to the shapes of q and k. Similarly, if q and k have
+            the shape [batch_size, seq_len, heads, head_dim], then set unsqueeze_dim=2.
+    Returns:
+        `tuple(torch.Tensor)` comprising of the query and key tensors rotated using the Rotary Position Embedding.
+    """
+    cos = cos.unsqueeze(unsqueeze_dim)
+    sin = sin.unsqueeze(unsqueeze_dim)
+    q_embed = (q * cos) + (rotate_half(q) * sin)
+    k_embed = (k * cos) + (rotate_half(k) * sin)
+    return q_embed, k_embed
+
+
+def repeat_kv(hidden_states: torch.Tensor, n_rep: int) -> torch.Tensor:
+    """
+    This is the equivalent of torch.repeat_interleave(x, dim=1, repeats=n_rep). The hidden states go from (batch,
+    num_key_value_heads, seqlen, head_dim) to (batch, num_attention_heads, seqlen, head_dim)
+    """
+    batch, num_key_value_heads, slen, head_dim = hidden_states.shape
+    if n_rep == 1:
+        return hidden_states
+    hidden_states = hidden_states[:, :, None, :, :].expand(batch, num_key_value_heads, n_rep, slen, head_dim)
+    return hidden_states.reshape(batch, num_key_value_heads * n_rep, slen, head_dim)
+
+
+def eager_attention_forward(
+    module: nn.Module,
+    query: torch.Tensor,
+    key: torch.Tensor,
+    value: torch.Tensor,
+    attention_mask: torch.Tensor | None,
+    scaling: float,
+    dropout: float = 0.0,
+    **kwargs: Unpack[TransformersKwargs],
+):
+    key_states = repeat_kv(key, module.num_key_value_groups)
+    value_states = repeat_kv(value, module.num_key_value_groups)
+
+    attn_weights = torch.matmul(query, key_states.transpose(2, 3)) * scaling
+    if attention_mask is not None:
+        attn_weights = attn_weights + attention_mask
+
+    attn_weights = nn.functional.softmax(attn_weights, dim=-1, dtype=torch.float32).to(query.dtype)
+    attn_weights = nn.functional.dropout(attn_weights, p=dropout, training=module.training)
+    attn_output = torch.matmul(attn_weights, value_states)
+    attn_output = attn_output.transpose(1, 2).contiguous()
+
+    return attn_output, attn_weights
+
+
+@use_kernelized_func(apply_rotary_pos_emb)
+class Mimir2Attention(nn.Module):
+    """Multi-headed attention from 'Attention Is All You Need' paper"""
+
+    def __init__(self, config: Mimir2Config, layer_idx: int):
+        super().__init__()
+        self.config = config
+        self.layer_idx = layer_idx
+        self.head_dim = getattr(config, "head_dim", config.hidden_size // config.num_attention_heads)
+        self.num_key_value_groups = 1  # Uses MHA instead of GQA
+        self.scaling = self.head_dim**-0.5
+        self.attention_dropout = config.attention_dropout
+        self.is_causal = True
+
+        self.q_proj = nn.Linear(
+            config.hidden_size, config.num_attention_heads * self.head_dim, bias=config.attention_bias
+        )
+        self.k_proj = nn.Linear(
+            config.hidden_size,
+            config.num_attention_heads * self.head_dim,
+            bias=config.attention_bias,
+        )
+        self.v_proj = nn.Linear(
+            config.hidden_size,
+            config.num_attention_heads * self.head_dim,
+            bias=config.attention_bias,
+        )
+        self.o_proj = nn.Linear(
+            config.num_attention_heads * self.head_dim, config.hidden_size, bias=config.attention_bias
+        )
+        # Additional sigmoid gate applied at the end
+        self.gate_proj = nn.Linear(
+            config.hidden_size,
+            config.num_attention_heads * self.head_dim,
+            bias=config.attention_bias,
+        )
+
+    def forward(
+        self,
+        hidden_states: torch.Tensor,
+        position_embeddings: tuple[torch.Tensor, torch.Tensor] | None = None,
+        attention_mask: torch.Tensor | None = None,
+        past_key_values: Cache | None = None,
+        cycle_offset: int = 0,
+        **kwargs: Unpack[TransformersKwargs],
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        input_shape = hidden_states.shape[:-1]
+        hidden_shape = (*input_shape, -1, self.head_dim)
+
+        query_states = self.q_proj(hidden_states).view(hidden_shape).transpose(1, 2)
+        key_states = self.k_proj(hidden_states).view(hidden_shape).transpose(1, 2)
+        value_states = self.v_proj(hidden_states).view(hidden_shape).transpose(1, 2)
+        gate_states = self.gate_proj(hidden_states).view(hidden_shape)
+
+        cos, sin = position_embeddings
+        query_states, key_states = apply_rotary_pos_emb(query_states, key_states, cos, sin)
+
+        if past_key_values is not None:
+            # Adjust cache slot by `cycle_offset` which is determined by it's current recurrent step through the stacks
+            key_states, value_states = past_key_values.update(key_states, value_states, self.layer_idx + cycle_offset)
+
+        attention_interface: Callable = ALL_ATTENTION_FUNCTIONS.get_interface(
+            self.config._attn_implementation, eager_attention_forward
+        )
+        attn_output, attn_weights = attention_interface(
+            self,
+            query_states,
+            key_states,
+            value_states,
+            attention_mask,
+            dropout=0.0 if not self.training else self.attention_dropout,
+            scaling=self.scaling,
+            **kwargs,
+        )
+
+        # Additional sigmoid gating (similar to Qwen3Next)
+        attn_output = torch.sigmoid(gate_states) * attn_output
+        attn_output = attn_output.reshape(*input_shape, -1).contiguous()
+        attn_output = self.o_proj(attn_output)
+        return attn_output, attn_weights
+
+
+class Mimir2MLP(nn.Module):
+    def __init__(self, config):
+        super().__init__()
+        self.config = config
+        self.hidden_size = config.hidden_size
+        self.intermediate_size = config.intermediate_size
+        self.gate_proj = nn.Linear(self.hidden_size, self.intermediate_size, bias=config.mlp_bias)
+        self.up_proj = nn.Linear(self.hidden_size, self.intermediate_size, bias=config.mlp_bias)
+        self.down_proj = nn.Linear(self.intermediate_size, self.hidden_size, bias=config.mlp_bias)
+        self.act_fn = ACT2FN[config.hidden_act]
+
+    def forward(self, x):
+        down_proj = self.down_proj(self.act_fn(self.gate_proj(x)) * self.up_proj(x))
+        return down_proj
+
+
+class Mimir2InvocationGate(nn.Module):
+    def __init__(self, hidden_size):
+        super().__init__()
+        self.weight = nn.Parameter(torch.zeros(hidden_size, 2 * hidden_size))
+        self.bias = nn.Parameter(torch.zeros(hidden_size))
+
+    def forward(self, hidden, injection, alpha):
+        hidden, injection = torch.broadcast_tensors(hidden, injection)
+        inputs = torch.cat((hidden, injection), dim=-1)
+        gate = F.linear(inputs, self.weight.to(inputs.dtype), self.bias.to(inputs.dtype))
+        return injection * (1 + alpha.to(inputs.dtype) * torch.tanh(gate))
+
+
+class Mimir2Router(nn.Module):
+    def __init__(self, config, count, active):
+        super().__init__()
+        self.active = active
+        self.top1_straight_through = config.router_top1_straight_through
+        self.rows = nn.ParameterList(
+            [
+                nn.Parameter(torch.zeros(config.hidden_size), requires_grad=not (config.expert_freeze_base and i == 0))
+                for i in range(count)
+            ]
+        )
+        self.biases = nn.ParameterList(
+            [
+                nn.Parameter(torch.zeros(1), requires_grad=not (config.expert_freeze_base and i == 0))
+                for i in range(count)
+            ]
+        )
+        self.register_buffer("logit_bias", torch.zeros(count))
+
+    def forward(self, hidden_states):
+        scores = (
+            F.linear(hidden_states.float(), torch.stack(list(self.rows)).float(), torch.cat(list(self.biases)).float())
+            + self.logit_bias.float()
+        )
+        selected = scores.argsort(dim=-1, descending=True, stable=True)[..., : self.active]
+        mask = torch.zeros_like(scores, dtype=torch.bool).scatter(-1, selected, True)
+        weights = scores.masked_fill(~mask, -torch.inf).softmax(-1)
+        if self.active == 1 and len(self.rows) > 1 and self.top1_straight_through:
+            surrogate = scores.softmax(-1) * mask
+            weights = weights + (surrogate - surrogate.detach())
+        return weights
+
+
+class Mimir2MLPMixture(nn.Module):
+    def __init__(self, config, original):
+        super().__init__()
+        self.experts = nn.ModuleList([original] + [copy.deepcopy(original) for _ in range(config.moe_num_experts - 1)])
+        self.router = Mimir2Router(config, config.moe_num_experts, config.moe_top_k)
+        self.sparse = config.moe_sparse
+        if config.expert_freeze_base:
+            self.experts[0].requires_grad_(False)
+
+    def forward(self, hidden_states):
+        weights = self.router(hidden_states)
+        if self.sparse:
+            flat = hidden_states.reshape(-1, hidden_states.shape[-1])
+            weights = weights.reshape(-1, len(self.experts))
+            output = torch.zeros_like(flat)
+            for i, expert in enumerate(self.experts):
+                indices = (weights[:, i] != 0).nonzero().flatten()
+                candidate = expert(flat.index_select(0, indices))
+                output = output.index_add(0, indices, candidate * weights[indices, i, None].to(candidate.dtype))
+            return output.reshape_as(hidden_states)
+        output = torch.zeros_like(hidden_states)
+        for i, expert in enumerate(self.experts):
+            candidate = expert(hidden_states)
+            output = output + weights[..., i : i + 1].to(candidate.dtype) * candidate
+        return output
+
+
+class Mimir2ResidualConnection(nn.Module):
+    def __init__(self, branches, hidden_size, preferred_branch, init_scale, input_dependent=False):
+        super().__init__()
+        self.read_logits = nn.Parameter(torch.zeros(branches, hidden_size))
+        write = torch.full((branches, hidden_size), -init_scale / branches)
+        write[preferred_branch % branches] += init_scale
+        self.write_logits = nn.Parameter(write)
+        self.branches = branches
+        if input_dependent:
+            self.read_gain = nn.Parameter(torch.zeros(branches, hidden_size))
+            self.write_gain = nn.Parameter(torch.zeros(branches, hidden_size))
+
+    def weights(self, streams, alpha, kind):
+        logits = getattr(self, f"{kind}_logits").float()
+        if hasattr(self, f"{kind}_gain"):
+            logits = logits + streams.float().tanh() * getattr(self, f"{kind}_gain").float()
+        return (alpha.float() * logits).softmax(dim=-2)
+
+    def read(self, streams, alpha):
+        return (streams.float() * self.weights(streams, alpha, "read")).sum(dim=-2).to(streams.dtype)
+
+    def write(self, streams, update, alpha):
+        weights = self.branches * self.weights(streams, alpha, "write")
+        return (streams.float() + weights * update.float().unsqueeze(-2)).to(streams.dtype)
+
+
+class Mimir2RecurrentMemory(Mimir2ResidualConnection):
+    def __init__(self, branches, hidden_size, alpha):
+        super().__init__(branches, hidden_size, 0, 0.1, input_dependent=True)
+        self.register_buffer("alpha", torch.tensor(alpha))
+
+    def initialize(self, hidden_states):
+        return hidden_states.unsqueeze(-2).expand(*hidden_states.shape[:-1], self.branches, hidden_states.shape[-1])
+
+    def read_state(self, states):
+        return self.read(states, self.alpha)
+
+    def update(self, states, candidate):
+        retain = self.alpha * (1 - self.weights(states, self.alpha, "write"))
+        return (retain * states.float() + (1 - retain) * candidate.float().unsqueeze(-2)).to(candidate.dtype)
+
+
+class Mimir2NGramMemory(nn.Module):
+    def __init__(self, config):
+        super().__init__()
+        self.orders = tuple(config.ngram_orders)
+        self.buckets = config.ngram_buckets
+        self.heads = config.ngram_heads
+        self.contextual_gate = config.ngram_contextual_gate
+        self.tables = nn.ParameterList(
+            [
+                nn.Parameter(torch.zeros(self.buckets, config.hidden_size // self.heads))
+                for _ in self.orders
+                for _ in range(self.heads)
+            ]
+        )
+        if self.contextual_gate:
+            self.query = nn.Linear(config.hidden_size, config.hidden_size, bias=False)
+            self.key = nn.Linear(config.hidden_size, config.hidden_size, bias=False)
+        self.register_buffer("alpha", torch.tensor(config.ngram_alpha))
+
+    def forward(self, x, tokens, position_ids=None, history=None):
+        if tokens.shape != x.shape[:-1] or tokens.ndim not in (1, 2):
+            raise ValueError("N-gram tokens must match [tokens] or [batch, tokens] embeddings")
+        if history is not None and position_ids is None:
+            raise ValueError("Cached n-grams require explicit position_ids for sequence resets")
+        ids = tokens.long().reshape(-1, tokens.shape[-1])
+        positions = (
+            torch.arange(ids.shape[-1], device=ids.device).expand_as(ids)
+            if position_ids is None
+            else position_ids.expand_as(ids)
+        )
+        prefix = 0
+        if history is not None and "tokens" in history:
+            if history["tokens"].shape[0] != ids.shape[0]:
+                raise ValueError("N-gram cache batch changed; create/reset cache for new requests")
+            prefix = history["tokens"].shape[-1]
+            ids = torch.cat((history["tokens"], ids), dim=-1)
+            positions = torch.cat((history["positions"], positions), dim=-1)
+        hashed = [torch.zeros_like(ids) for _ in range(self.heads)]
+        valid = torch.ones_like(ids, dtype=torch.bool)
+        output = torch.zeros((*ids.shape, x.shape[-1]), dtype=x.dtype, device=x.device)
+        for offset in range(max(self.orders)):
+            shifted = ids.roll(offset, dims=-1)
+            valid = valid & (torch.arange(ids.shape[-1], device=ids.device) >= offset)
+            valid = valid & (positions - positions.roll(offset, dims=-1) == offset)
+            # Distinct polynomial bases, not constant offsets of the same hash.
+            hashed = [
+                (value * (65599 + 2 * head) + shifted + 1).remainder(self.buckets) for head, value in enumerate(hashed)
+            ]
+            if offset + 1 in self.orders:
+                start = self.orders.index(offset + 1) * self.heads
+                retrieved = torch.cat(
+                    [
+                        torch.nn.functional.embedding(value, self.tables[start + head])
+                        for head, value in enumerate(hashed)
+                    ],
+                    dim=-1,
+                )
+                output = output + retrieved.to(x.dtype) * valid[..., None]
+        if history is not None:
+            tail = max(self.orders) - 1
+            history["tokens"] = ids[:, -tail:].detach().clone()
+            history["positions"] = positions[:, -tail:].detach().clone()
+        output = output[:, prefix:].reshape_as(x)
+        if self.contextual_gate:
+            # Normalize without changing parameter dtype; FSDP/autocast own precision.
+            context = torch.nn.functional.rms_norm(x, (x.shape[-1],), eps=1e-6)
+            memory = torch.nn.functional.rms_norm(output, (output.shape[-1],), eps=1e-6)
+            gate = torch.sigmoid(self.query(context) + self.key(memory))
+            output = gate.to(x.dtype) * output
+        return x + self.alpha.to(x.dtype) * output
+
+
+class Mimir2DynamicCache(DynamicCache):
+    """Attention slots plus request-local n-gram history; never model-global decoding state."""
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.ngram_history = {}
+        self.mos_routes = None
+        self.mos_reference_layer = None
+
+    def get_seq_length(self, layer_idx=0):
+        return super().get_seq_length(self.mos_reference_layer if self.mos_reference_layer is not None else layer_idx)
+
+    def get_mask_sizes(self, query_length, layer_idx=0):
+        return super().get_mask_sizes(
+            query_length, self.mos_reference_layer if self.mos_reference_layer is not None else layer_idx
+        )
+
+    @property
+    def is_initialized(self):
+        if self.mos_reference_layer is not None:
+            return self.get_seq_length() > 0
+        return super().is_initialized
+
+    def reorder_cache(self, beam_idx):
+        super().reorder_cache(beam_idx)
+        if self.mos_routes is not None:
+            self.mos_routes = self.mos_routes.index_select(0, beam_idx.to(self.mos_routes.device))
+        self.ngram_history = {
+            key: value.index_select(0, beam_idx.to(value.device)) for key, value in self.ngram_history.items()
+        }
+
+    def batch_repeat_interleave(self, repeats):
+        super().batch_repeat_interleave(repeats)
+        if self.mos_routes is not None:
+            self.mos_routes = self.mos_routes.repeat_interleave(repeats, dim=0)
+        self.ngram_history = {
+            key: value.repeat_interleave(repeats, dim=0) for key, value in self.ngram_history.items()
+        }
+
+    def batch_select_indices(self, indices):
+        super().batch_select_indices(indices)
+        if self.mos_routes is not None:
+            self.mos_routes = self.mos_routes[indices]
+        self.ngram_history = {key: value[indices] for key, value in self.ngram_history.items()}
+
+    def crop(self, max_length):
+        if self.ngram_history:
+            raise ValueError("Cropping n-gram history is not supported; disable speculative decoding")
+        if self.mos_routes is not None and max_length != 0:
+            raise ValueError("Cropping sparse MoS routing history is not supported; reset the cache for a new prompt")
+        super().crop(max_length)
+
+    def reset(self):
+        super().reset()
+        self.mos_routes = None
+        self.ngram_history.clear()
+
+
+class Mimir2SparseCacheView:
+    """Scatter selected request KV into full-batch slots; beam operations stay ordinary."""
+
+    def __init__(self, cache, selected, batch_size):
+        self.cache, self.selected, self.batch_size = cache, selected, batch_size
+
+    def update(self, key_states, value_states, layer_idx, *args, **kwargs):
+        shape = (self.batch_size, *key_states.shape[1:])
+        keys = key_states.new_zeros(shape).index_copy(0, self.selected, key_states)
+        values = value_states.new_zeros(shape).index_copy(0, self.selected, value_states)
+        keys, values = self.cache.update(keys, values, layer_idx, *args, **kwargs)
+        return keys.index_select(0, self.selected), values.index_select(0, self.selected)
+
+
+class Mimir2DecoderLayer(GradientCheckpointingLayer):
+    def __init__(self, config: Mimir2Config, layer_idx: int):
+        super().__init__()
+        self.hidden_size = config.hidden_size
+
+        self.self_attn = Mimir2Attention(config=config, layer_idx=layer_idx)
+
+        self.mlp = Mimir2MLP(config)
+        self.input_layernorm = Mimir2RMSNorm(eps=config.rms_norm_eps)
+        self.post_attention_layernorm = Mimir2RMSNorm(eps=config.rms_norm_eps)
+
+    def forward(self, hidden_states, residual_alpha=None, **kwargs) -> torch.Tensor:
+        if residual_alpha is None:
+            update, _ = self.self_attn(self.input_layernorm(hidden_states), **kwargs)
+            hidden_states = hidden_states + update
+            return hidden_states + self.mlp(self.post_attention_layernorm(hidden_states))
+        attn_input = self.input_layernorm(self.attn_residual.read(hidden_states, residual_alpha))
+        update, _ = self.self_attn(attn_input, **kwargs)
+        hidden_states = self.attn_residual.write(hidden_states, update, residual_alpha)
+        mlp_input = self.post_attention_layernorm(self.mlp_residual.read(hidden_states, residual_alpha))
+        return self.mlp_residual.write(hidden_states, self.mlp(mlp_input), residual_alpha)
+
+
+class Mimir2Stack(nn.Module):
+    """A single transformer stack — used twice inside, once as H module and once as L module"""
+
+    def __init__(self, config, level="L"):
+        super().__init__()
+        self.layers = nn.ModuleList(
+            [Mimir2DecoderLayer(config, layer_idx) for layer_idx in range(config.num_layers_per_stack)]
+        )
+        self.final_norm = Mimir2RMSNorm(eps=config.rms_norm_eps)
+        self.branches = config.residual_branches if config.residual_levels in (level, "both") else 1
+        for index, layer in enumerate(self.layers):
+            if config.moe_num_experts > 1 and config.moe_levels in (level, "both"):
+                layer.mlp = Mimir2MLPMixture(config, layer.mlp)
+            if self.branches > 1:
+                for offset, name in enumerate(("attn_residual", "mlp_residual")):
+                    setattr(
+                        layer,
+                        name,
+                        Mimir2ResidualConnection(
+                            self.branches,
+                            config.hidden_size,
+                            2 * index + offset,
+                            config.residual_write_init_scale,
+                            config.residual_input_dependent,
+                        ),
+                    )
+        if self.branches > 1:
+            self.residual_readout = nn.Parameter(torch.zeros(self.branches, config.hidden_size))
+            self.register_buffer("residual_alpha", torch.tensor(config.residual_alpha))
+
+    def forward(self, hidden_states, **kwargs) -> torch.Tensor:
+        if self.branches == 1:
+            for layer in self.layers:
+                hidden_states = layer(hidden_states, **kwargs)
+            return self.final_norm(hidden_states)
+        streams = hidden_states.unsqueeze(-2).expand(*hidden_states.shape[:-1], self.branches, hidden_states.shape[-1])
+        for layer in self.layers:
+            streams = layer(streams, residual_alpha=self.residual_alpha, **kwargs)
+        weights = (self.residual_alpha.float() * self.residual_readout.float()).softmax(dim=0)
+        return self.final_norm((streams.float() * weights).sum(dim=-2).to(hidden_states.dtype))
+
