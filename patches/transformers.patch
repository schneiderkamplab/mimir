+        from models.baselines.hrm_v2 import HierarchicalReasoningModel
+        from models.lm_head import LMHead
+
+        def attention(q, k, v, causal, **kwargs):
+            mask = None
+            if not causal:
+                positions = torch.arange(q.shape[-3])
+                mask = (positions[:, None] >= positions[None, :]) | (
+                    (positions[:, None] < 2) & (positions[None, :] < 2)
+                )
+            return F.scaled_dot_product_attention(
+                q.transpose(-3, -2), k.transpose(-3, -2), v.transpose(-3, -2), is_causal=causal, attn_mask=mask
+            ).transpose(-3, -2)
+
+        features = [
+            {},
+            {"gates_enabled": True},
+            {"moe_num_experts": 3, "moe_top_k": 2, "moe_sparse": True},
+            {"mos_num_experts": 2, "mos_top_k": 2, "mos_state_mode": "separate"},
+            {"residual_branches": 2, "residual_input_dependent": True},
+            {"h_memory_branches": 2, "l_memory_branches": 2},
+            {"ngram_orders": [2, 3]},
+            {"ngram_orders": [2, 3], "ngram_heads": 4, "ngram_contextual_gate": True},
+            {
+                "gates_enabled": True,
+                "moe_num_experts": 2,
+                "moe_top_k": 2,
+                "moe_levels": "both",
+                "mos_num_experts": 2,
+                "mos_top_k": 2,
+                "residual_branches": 2,
+                "h_memory_branches": 2,
+                "l_memory_branches": 2,
+                "ngram_orders": [2, 3],
+            },
+        ]
+        for extra in features:
+            with self.subTest(extra=extra), patch("models.layers.flash_attn_varlen_prefixlm", attention):
+                config = dict(
+                    hidden_size=16,
+                    num_heads=2,
+                    n_layers=2,
+                    half_layers=True,
+                    expansion=1,
+                    norm_type="pre",
+                    norm_eps=1e-6,
+                    init_type="lecun_normal",
+                    pos_emb_type="rope",
+                    rope_theta=10000,
+                    max_seq_len=16,
+                    H_cycles=2,
+                    L_cycles=3,
+                    bp_max_steps=8,
+                    bp_warmup_ratio=0,
+                    fwd_bwd_dtype="float32",
+                    vocab_size=32,
+                    attn_type="causal",
+                    **extra,
+                )
+                torch.manual_seed(123)
+                native = LMHead(HierarchicalReasoningModel(config), config).eval()
+                with torch.no_grad():
+                    for name, param in native.named_parameters():
+                        if any(
+                            part in name for part in ("invocation_gates", "read_gain", "ngram.tables", "router.rows")
+                        ):
+                            param.normal_(std=0.1)
+                    for name, buffer in native.named_buffers():
+                        if name.endswith("alpha"):
